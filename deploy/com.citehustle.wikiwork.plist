<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.citehustle.wikiwork</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/__USER__/Github/cite-hustle/deploy/run_wiki_work.sh</string>
    </array>
    <!-- At login (resumes after the machine was off) and daily at 03:00.
         launchd never starts a second copy while one is still running. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/__USER__/Library/Logs/cite-hustle/wikiwork.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/__USER__/Library/Logs/cite-hustle/wikiwork.err.log</string>
</dict>
</plist>
